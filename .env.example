# 默认使用哪个 provider；可选：mac-mlx / win-ollama / cloud
DEFAULT_PROVIDER=mac-mlx

# 本地/局域网模型名；MLX server 和 Ollama 都通过 OpenAI-compatible 协议调用
GEMMA_MODEL=gemma-4-e4b-it

# Mac 裸机运行 mlx_lm.server 时，本机开发可用 localhost
# 如果应用跑在 Docker 容器里，请在真实 .env 中改成：
# MAC_MLX_BASE_URL=http://host.docker.internal:8000/v1
MAC_MLX_BASE_URL=http://localhost:8000/v1
MAC_MLX_API_KEY=local-dev-key

# Windows 上 Ollama 的局域网 IP；如果设置 WIN_OLLAMA_BASE_URL，会优先用完整 URL
WIN_LAN_IP=192.168.1.100
WIN_OLLAMA_BASE_URL=http://192.168.1.100:11434/v1
WIN_OLLAMA_API_KEY=ollama-dev-key

# OpenAI-compatible 云端网关；真实 key 只写入 .env，不提交 git
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# SQLite 数据库文件路径；compose 会把宿主机 ./data 挂载到容器 /app/data
DATABASE_PATH=data/butler.db
